---
// Caseta „Cum citați această pagină” de la sfârșitul paginilor de documentație: referința în stil APA și intrarea
// BibTeX. Data este cea a ultimei modificări a paginii (din git), iar autorii vin din câmpul `authors` al paginii
// sau, implicit, din SITE.author.
import { Code } from '@astrojs/starlight/components';
import { CITARE, SITE } from '../consts';

const { entry, lastUpdated } = Astro.locals.starlightRoute;
const titlu = entry.data.title;
const url = new URL(Astro.url.pathname, SITE.url).href;
const data = lastUpdated ?? new Date();
const an = data.getUTCFullYear();
const ziLuna = data.toLocaleDateString('ro', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const dataCompleta = data.toLocaleDateString('ro', { dateStyle: 'long', timeZone: 'UTC' });

// „Adrian Mircea Nenu” devine „Nenu, A. M.” (APA) și „Nenu, Adrian Mircea” (BibTeX).
const nume = (entry.data.authors ?? [SITE.author.name]).map((autor) => {
  const parti = autor.trim().split(/\s+/);
  const familie = parti.pop() ?? autor;
  return { familie, prenume: parti.join(' '), initiale: parti.map((p) => `${p[0]}.`).join(' ') };
});
const apa = nume.map((n) => (n.initiale ? `${n.familie}, ${n.initiale}` : n.familie));
const autoriApa = apa.length > 1 ? `${apa.slice(0, -1).join(', ')} și ${apa.at(-1)}` : apa[0];

// Cheia BibTeX: numele de familie al primului autor, anul și primul cuvânt semnificativ din titlu, fără diacritice.
const ascii = (text: string) =>
  text
    .normalize('NFD')
    .replace(/\p{M}/gu, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
const CUVINTE_DE_LEGATURA = new Set(['ce', 'cum', 'este', 'sunt', 'un', 'o', 'de', 'la', 'si', 'in', 'cu', 'pentru']);
const cuvant = ascii(titlu)
  .split(' ')
  .find((c) => !CUVINTE_DE_LEGATURA.has(c));
const cheie = `${ascii(nume[0].familie).replace(/ /g, '')}${an}${cuvant ?? ''}`;

const bibtex = `@misc{${cheie},
  author       = {${nume.map((n) => (n.prenume ? `${n.familie}, ${n.prenume}` : n.familie)).join(' and ')}},
  title        = {{${titlu}}},
  year         = {${an}},
  howpublished = {${SITE.name}},
  url          = {${url}},
  note         = {Ultima actualizare: ${dataCompleta}}
}`;
---

<section class='citare' aria-labelledby={CITARE.id} data-pagefind-ignore>
  <h2 id={CITARE.id}>{CITARE.titlu}</h2>
  <p>
    {autoriApa} ({an}, {ziLuna}). <i>{titlu}</i>. {SITE.name}. <a href={url}>{url}</a>
  </p>
  <details>
    <summary>BibTeX</summary>
    <Code code={bibtex} lang='bibtex' />
  </details>
</section>

<style>
  .citare {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  h2 {
    margin: 0 0 0.75rem;
    font-family: var(--sl-exquisitus-font-register);
    font-size: var(--sl-text-h5);
    font-weight: 600;
    color: var(--sl-color-white);
  }

  p {
    margin: 0;
    font-family: var(--sl-exquisitus-font-reading);
    color: var(--sl-color-gray-2);
    overflow-wrap: anywhere;
  }

  details {
    margin-top: 0.75rem;
  }

  summary {
    width: fit-content;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-text-accent);
    cursor: pointer;
  }

  details :global(.expressive-code) {
    margin-top: 0.5rem;
  }
</style>
