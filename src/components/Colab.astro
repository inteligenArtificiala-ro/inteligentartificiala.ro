---
/**
 * Butonul care deschide în Google Colab notebookul Jupyter al unui laborator, citit din repozitoriul site-ului de pe
 * GitHub, și legătura de descărcare a aceluiași fișier de pe site.
 *
 * ```mdx
 * import Colab from '@components/Colab.astro';
 *
 * <Colab notebook="laboratoare/difuzie-imagini-si-sunete/notebooks/01-prezentare.ipynb" />
 * ```
 *
 * Colab citește fișierul de pe ramura `main`, așa că un notebook nou se deschide abia după ce ajunge pe GitHub.
 * Pagina nu încarcă nimic de la Google: logoul este desenat aici, iar Colab primește vizitatorul doar după clic.
 */
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { SITE } from '../consts';

interface Props {
  /** Calea notebookului, relativă la public/. */
  notebook: string;
}

const { notebook } = Astro.props;
if (!existsSync(join(process.cwd(), 'public', notebook))) {
  throw new Error(`Notebookul ${notebook} nu există în public/.`);
}

const colab = `${SITE.repo.replace('https://github.com/', 'https://colab.research.google.com/github/')}/blob/main/public/${notebook}`;
---

<p class='colab not-content' data-pagefind-ignore>
  <a class='deschidere' href={colab}>
    <svg viewBox='-2 0 28 24' aria-hidden='true'>
      <path
        fill='#e8710a'
        d='M1.977,16.77c-2.667-2.277-2.605-7.079,0-9.357C2.919,8.057,3.522,9.075,4.49,9.691c-1.152,1.6-1.146,3.201-0.004,4.803C3.522,15.111,2.918,16.126,1.977,16.77z'
      ></path>
      <path
        fill='#f9ab00'
        d='M12.257,17.114c-1.767-1.633-2.485-3.658-2.118-6.02c0.451-2.91,2.139-4.893,4.946-5.678c2.565-0.718,4.964-0.217,6.878,1.819c-0.884,0.743-1.707,1.547-2.434,2.446C18.488,8.827,17.319,8.435,16,8.856c-2.404,0.767-3.046,3.241-1.494,5.644c-0.241,0.275-0.493,0.541-0.721,0.826C13.295,15.939,12.511,16.3,12.257,17.114z'
      ></path>
      <path
        fill='#e8710a'
        d='M19.529,9.682c0.727-0.899,1.55-1.703,2.434-2.446c2.703,2.783,2.701,7.031-0.005,9.764c-2.648,2.674-6.936,2.725-9.701,0.115c0.254-0.814,1.038-1.175,1.528-1.788c0.228-0.285,0.48-0.552,0.721-0.826c1.053,0.916,2.254,1.268,3.6,0.83C20.502,14.551,21.151,11.927,19.529,9.682z'
      ></path>
      <path
        fill='#f9ab00'
        d='M4.49,9.691C3.522,9.075,2.919,8.057,1.977,7.413c2.209-2.398,5.721-2.942,8.476-1.355c0.555,0.32,0.719,0.606,0.285,1.128c-0.157,0.188-0.258,0.422-0.391,0.631c-0.299,0.47-0.509,1.067-0.929,1.371C8.933,9.539,8.523,8.847,8.021,8.746C6.673,8.475,5.509,8.787,4.49,9.691z'
      ></path>
      <path
        fill='#f9ab00'
        d='M1.977,16.77c0.941-0.644,1.545-1.659,2.509-2.277c1.373,1.152,2.85,1.433,4.45,0.499c0.332-0.194,0.503-0.088,0.673,0.19c0.386,0.635,0.753,1.285,1.181,1.89c0.34,0.48,0.222,0.715-0.253,1.006C7.84,19.73,4.205,19.188,1.977,16.77z'
      ></path>
    </svg>
    Deschidere în Google Colab
  </a>
  <a class='descarcare' href={`/${notebook}`} download>Descărcare notebook</a>
</p>

<style>
  .colab {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1.25rem;
    margin-block: 1.25rem;
    font-family: var(--sl-font);
  }

  .deschidere {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.9rem 0.4rem 0.7rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  .deschidere:hover,
  .deschidere:focus-visible {
    border-color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  /* Logoul are fundal alb, ca în insigna oficială, ca să se vadă la fel în ambele moduri de afișare. */
  svg {
    width: 1.6rem;
    height: 1.35rem;
    padding: 0.1rem;
    border-radius: 3px;
    background: #fff;
  }

  .descarcare {
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .descarcare:hover {
    color: var(--sl-color-white);
  }
</style>
