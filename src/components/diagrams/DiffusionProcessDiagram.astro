---
// Procesul direct și procesul invers al unui model de difuzie, pe un desen de 7 x 7 pixeli (litera A).
// Pixelii cu zgomot sunt calculați la build, cu un generator de numere aleatoare cu sămânță fixă.
import '../../styles/diagrams.css';

const LETTER = ['..###..', '.#...#.', '#.....#', '#######', '#.....#', '#.....#', '#.....#'];
const x0 = LETTER.join('').split('').map((c) => (c === '#' ? 1 : -1));

// mulberry32: același zgomot la fiecare build, ca diagrama să nu se schimbe.
function random(seed: number) {
  let a = seed;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const next = random(11);
// Box-Muller: zgomot gaussian standard. Același zgomot pentru toate etapele, doar proporția lui crește.
const noise = x0.map(() => Math.sqrt(-2 * Math.log(1 - next())) * Math.cos(2 * Math.PI * next()));

const T = 1000;
const STEPS = [0, 250, 500, 750, 1000];
const CELL = 12;
const SIZE = 7 * CELL;
const TOP = 52;
const LEFT = 40;
const PITCH = 140;

const grids = STEPS.map((t, index) => {
  // Programul de zgomot în formă de cosinus: cât din imagine rămâne la pasul t.
  const alphaBar = Math.max(Math.cos(((t / T) * Math.PI) / 2) ** 2, 0);
  const pixels = x0.map((value, i) => {
    const noisy = Math.sqrt(alphaBar) * value + Math.sqrt(1 - alphaBar) * noise[i];
    return Math.min(Math.max((noisy + 1) / 2, 0), 1);
  });
  const label = alphaBar < 0.005 ? 'ᾱ ≈ 0' : `ᾱ = ${alphaBar.toFixed(2).replace('.', ',')}`;
  return { x: LEFT + index * PITCH, t, label, pixels };
});
---

<figure class='diagram diffusion-process-diagram'>
  <div class='diagram-scroll'>
    <svg viewBox='0 0 740 228' role='img' aria-labelledby='diffusion-process-title diffusion-process-desc'>
      <title id='diffusion-process-title'>Procesul direct și procesul invers al unui model de difuzie</title>
      <desc id='diffusion-process-desc'>
        Un desen de 7 pe 7 pixeli cu litera A, la pașii 0, 250, 500, 750 și 1000. De la stânga la dreapta, procesul
        direct adaugă tot mai mult zgomot, până când desenul nu se mai vede. De la dreapta la stânga, procesul invers,
        învățat de o rețea neuronală, scoate zgomotul pas cu pas și ajunge la o imagine curată.
      </desc>
      <defs>
        <marker
          id='diffusion-arrow'
          viewBox='0 0 10 10'
          refX='9'
          refY='5'
          markerWidth='6'
          markerHeight='6'
          orient='auto-start-reverse'
        >
          <path d='M 0 0 L 10 5 L 0 10 z'></path>
        </marker>
        <marker
          id='diffusion-arrow-reverse'
          viewBox='0 0 10 10'
          refX='9'
          refY='5'
          markerWidth='6'
          markerHeight='6'
          orient='auto-start-reverse'
        >
          <path class='reverse' d='M 0 0 L 10 5 L 0 10 z'></path>
        </marker>
      </defs>

      <text class='title' x={LEFT} y={28}>Procesul direct: se adaugă zgomot (fix) →</text>

      {
        grids.map((grid) => (
          <g>
            <rect class='frame' x={grid.x - 1} y={TOP - 1} width={SIZE + 2} height={SIZE + 2} />
            {grid.pixels.map((value, i) => (
              <rect
                class='pixel'
                x={grid.x + (i % 7) * CELL}
                y={TOP + Math.floor(i / 7) * CELL}
                width={CELL}
                height={CELL}
                fill-opacity={value.toFixed(2)}
              />
            ))}
            <text x={grid.x + SIZE / 2} y={TOP + SIZE + 22} text-anchor='middle'>
              t = {grid.t}
            </text>
            <text class='label' x={grid.x + SIZE / 2} y={TOP + SIZE + 40} text-anchor='middle'>
              {grid.label}
            </text>
          </g>
        ))
      }

      <g class='arrow' marker-end='url(#diffusion-arrow)'>
        {grids.slice(0, -1).map((grid) => <path d={`M${grid.x + SIZE + 8} ${TOP + 28} H${grid.x + PITCH - 8}`} />)}
      </g>
      <g class='arrow reverse' marker-end='url(#diffusion-arrow-reverse)'>
        {grids.slice(0, -1).map((grid) => <path d={`M${grid.x + PITCH - 8} ${TOP + 56} H${grid.x + SIZE + 8}`} />)}
      </g>

      <text class='title' x={LEFT} y={TOP + SIZE + 76}>← Procesul invers: rețeaua scoate zgomotul (învățat)</text>
    </svg>
  </div>
  <figcaption>
    Același zgomot, în proporții tot mai mari. ᾱ arată cât din desen mai rămâne la fiecare pas.
  </figcaption>
</figure>

<style>
  .diffusion-process-diagram svg {
    min-width: 34rem;
    max-width: 46rem;
  }

  .diffusion-process-diagram .frame {
    fill: var(--sl-color-bg);
    stroke: var(--sl-color-gray-4);
  }

  .diffusion-process-diagram .pixel {
    fill: var(--sl-color-white);
  }

  .diffusion-process-diagram .arrow.reverse {
    stroke: var(--sl-color-accent);
  }

  .diffusion-process-diagram marker path.reverse {
    fill: var(--sl-color-accent);
  }
</style>
