---
// Atenția cu mai multe capete (figura 2, dreapta, din „Attention Is All You Need”).
import '../../styles/diagrams.css';
import Box from './Box.astro';

// Fiecare cap are propriile proiecții liniare. Copiile din spate sugerează cele h capete.
const layers = [16, 8, 0];
const inputs = [
  { x: 130, name: 'V' },
  { x: 230, name: 'K' },
  { x: 330, name: 'Q' },
];
---

<figure class='diagram multi-head-diagram'>
  <svg viewBox='0 55 480 400' role='img' aria-labelledby='multi-head-title multi-head-desc'>
    <title id='multi-head-title'>Atenția cu capete multiple (multi-head)</title>
    <desc id='multi-head-desc'>
      V, K și Q trec fiecare prin câte o proiecție liniară pentru fiecare dintre cele h capete. Fiecare cap calculează
      atenția prin produs scalar scalat. Rezultatele capetelor se concatenează și trec printr-o ultimă proiecție liniară.
    </desc>
    <defs>
      <marker
        id='multi-head-arrow'
        viewBox='0 0 10 10'
        refX='9'
        refY='5'
        markerWidth='6'
        markerHeight='6'
        orient='auto-start-reverse'
      >
        <path d='M 0 0 L 10 5 L 0 10 z'></path>
      </marker>
    </defs>

    <g class='arrow' marker-end='url(#multi-head-arrow)'>
      {inputs.map(({ x }) => <path d={`M${x} 420 V382`} />)}
      {inputs.map(({ x }) => <path d={`M${x} 350 V296`} />)}
      <path d='M230 234 V204'></path>
      <path d='M230 170 V139'></path>
      <path d='M230 105 V82'></path>
    </g>

    {
      layers.map((offset) =>
        inputs.map(({ x }) => (
          <Box
            x={x - 40 + offset}
            y={350 - offset}
            width={80}
            height={32}
            kind='neutral'
            lines={offset === 0 ? ['Liniar'] : []}
          />
        )),
      )
    }
    {
      layers.map((offset) => (
        <Box
          x={90 + offset}
          y={250 - offset}
          width={280}
          height={46}
          kind='attention'
          lines={offset === 0 ? ['Atenție prin produs scalar scalat'] : []}
        />
      ))
    }
    <Box x={150} y={170} width={160} height={34} kind='norm' lines={['Concatenare']} />
    <Box x={180} y={105} width={100} height={34} kind='neutral' lines={['Liniar']} />

    <text class='label' x='395' y='255'>h capete</text>
    {inputs.map(({ x, name }) => <text class='math' x={x} y='440' text-anchor='middle'>{name}</text>)}
    <text class='label' x='230' y='72' text-anchor='middle'>Ieșire</text>
  </svg>
  <figcaption>Atenția cu capete multiple, după figura 2 din articol. Capetele lucrează în paralel.</figcaption>
</figure>

<style>
  .multi-head-diagram svg {
    max-width: 28rem;
  }
</style>
